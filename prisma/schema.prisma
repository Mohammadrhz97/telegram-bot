datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         Int        @id @default(autoincrement())
  telegramId String     @unique
  fullName   String?
  phone      String?
  city       String?
  address    String?
  createdAt  DateTime   @default(now())
  cartItems  CartItem[]
  orders     Order[]
}

model Product {
  id             Int         @id @default(autoincrement())
  model          String
  modelFull      String?
  brand          String
  material       String
  color          String
  price          Int
  imageUrl       String?
  createdAt      DateTime    @default(now())
  available      Boolean    @default(true)
  embedding      Float[]
  telegramFileId String?
  cartItems      CartItem[]
  orderItems     OrderItem[]
}

model CartItem {
  id        Int     @id @default(autoincrement())
  userId    Int
  productId Int
  qty       Int     @default(1)
  product   Product @relation(fields: [productId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
}

model Order {
  id         Int         @id @default(autoincrement())
  userId     Int
  totalPrice Int
  status     String      @default("pending")
  createdAt  DateTime    @default(now())
  address    String?
  city       String?
  phone      String?
  paymentUrl String?
  user       User        @relation(fields: [userId], references: [id])
  items      OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  qty       Int
  price     Int
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}
